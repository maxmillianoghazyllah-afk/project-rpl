[Unit]
Description=Sistem Antrean Kantin - Backend API Service
After=network.target mysql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/kantin/backend
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=kantin-backend
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=DATABASE_URL="mysql://root:password@127.0.0.1:3306/kantin_queue"
Environment=JWT_SECRET="kantin-secret-token-key-2026"

[Install]
WantedBy=multi-user.target
